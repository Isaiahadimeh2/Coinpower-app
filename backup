// --- ADMIN USER MANAGER ---
const AdminPanel = ({ allUsers }) => {
  const resetAccount = async (userId) => {
    if(window.confirm("Reset this account?")) {
      await supabase.from('profiles').update({ balance: 0 }).eq('id', userId);
      await supabase.from('user_rentals').delete().eq('user_id', userId); // Wipes machines
      alert("Account Reset Successful.");
    }
  };

  return (
    <div className="admin-list">
      {allUsers.map(user => (
        <div key={user.id} className="flex justify-between p-4 border-b">
          <span>{user.username} (${user.balance})</span>
          <div className="flex gap-2">
            <button className="bg-green-500 text-white p-1 px-3 rounded" onClick={() => creditUser(user.id)}>Credit</button>
            <button className="bg-red-500 text-white p-1 px-3 rounded" onClick={() => resetAccount(user.id)}>Reset</button>
          </div>
        </div>
      ))}
    </div>
  );
};
