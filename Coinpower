<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoinPower | Unified Platform</title>
    <style>
        :root { --gold: #fcc419; --bg: #fdfdfd; --dark: #1a1a1a; --red: #e03131; --green: #2ecc71; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); margin: 0; padding-bottom: 70px; color: #333; }
        .page { display: none; padding: 15px; max-width: 450px; margin: auto; }
        .active { display: block; }

        /* Shared Card Styles */
        .card { background: #fff; border-radius: 20px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 20px; border-top: 5px solid var(--gold); }
        
        /* Marketplace Header (Image 5298) */
        .wallet-header { background: var(--dark); color: white; border-radius: 20px; padding: 30px; text-align: center; margin-bottom: 25px; }
        .balance { font-size: 2.5rem; font-weight: bold; margin: 10px 0; }

        /* Banking Notice (Image 5313) */
        .lock-notice { background: #fff5f5; border: 1px solid #ffa8a8; border-radius: 12px; padding: 15px; display: flex; gap: 10px; color: var(--red); font-size: 0.85rem; }

        /* Security Items (Image 5319) */
        .protocol { display: flex; gap: 12px; margin-bottom: 15px; text-align: left; font-size: 0.9rem; }

        /* Bottom Nav */
        .nav { position: fixed; bottom: 0; width: 100%; background: white; display: flex; border-top: 1px solid #eee; padding: 10px 0; justify-content: space-around; font-size: 0.8rem; font-weight: bold; }
        .nav-item { text-align: center; color: #888; cursor: pointer; }
        .nav-item.active-nav { color: var(--gold); }

        /* Buttons */
        .btn-green { background: #28a745; color: white; border: none; padding: 12px; width: 100%; border-radius: 10px; font-weight: bold; cursor: pointer; }
        .btn-dark { background: var(--dark); color: white; border: none; padding: 15px; width: 100%; border-radius: 10px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>

    <div id="market" class="page active">
        <div class="wallet-header">
            <div>Wallet Balance</div>
            <div class="balance">$125.50</div>
            <div style="color: var(--gold);">Welcome, Isaiah!</div>
        </div>
        <h3>Marketplace</h3>
        <div class="card" style="text-align: center;">
            <b>PG2 Unit</b>
            <div style="color: var(--green); font-size: 1.2rem; margin: 10px 0;">$50.00</div>
            <button class="btn-green">Rent Now</button>
        </div>
    </div>

    <div id="withdraw" class="page">
        <div class="card">
            <h2 style="margin: 0 0 10px;">🏦 Banking Center</h2>
            <div class="lock-notice">
                <span>🚫</span>
                <div>
                    <b>Withdrawal Locked</b>
                    <p style="margin: 5px 0 0;">Upgrade to <b>PG2</b> to unlock the withdrawal gateway.</p>
                </div>
            </div>
            <p style="font-weight: bold; margin-top: 20px;">Select Country</p>
            <select style="width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #ddd;">
                <option>Ghana 🇬🇭</option>
                <option>Nigeria 🇳🇬</option>
            </select>
        </div>
    </div>

    <div id="about" class="page">
        <div class="card">
            <h2>Your Future in Energy Mining</h2>
            <img src="https://images.unsplash.com/photo-1510133769068-68884a12756b?w=400" style="width: 100%; border-radius: 10px;" alt="Hero">
            <p style="font-size: 0.9rem; line-height: 1.5; color: #666;">We are a premier global investment platform...</p>
        </div>

        <div class="card" style="border-top: 5px solid var(--red);">
            <h3 style="color: var(--gold); margin-top: 0;">Security Protocols</h3>
            <div class="protocol"><span>✅</span> <div><b>Refund Policy</b><p>Processed for failed mining nodes.</p></div></div>
            <div class="protocol"><span>❌</span> <div><b>Account Security</b><p>No bank removal without 2FA.</p></div></div>
            <button class="btn-dark" onclick="alert('Accepted')">I Understand & Accept</button>
        </div>
    </div>

    <div class="nav">
        <div class="nav-item active-nav" onclick="showPage('market', this)">🏠<br>Market</div>
        <div class="nav-item" onclick="showPage('withdraw', this)">💳<br>Withdraw</div>
        <div class="nav-item" onclick="showPage('about', this)">🛡️<br>Security</div>
    </div>

    <script>
        function showPage(pageId, navEl) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            // Remove active class from nav
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active-nav'));
            
            // Show selected page
            document.getElementById(pageId).classList.add('active');
            navEl.classList.add('active-nav');
        }
    </script>

</body>
</html>
